# Lintel, the demo embedded app: the app publisher's side of Rollout's Embedded Apps.
# Copy to .env.local for local runs. Never commit real values.

# Rollout dashboard → API page → Current secret. Rollout signs every launch's
# context for your apps with it; /embed checks the signature with it.
ROLLOUT_CLIENT_SECRET=

# Where Rollout serves its app script (app-v1.js).
ROLLOUT_ORIGIN=https://universal.rollout.com

# Optional. Leave empty to let any page frame the app (the simplest setup).
# To restrict framing, list the CRM page origins the app shows on; Lintel then
# sends CSP frame-ancestors with these plus Rollout's origin and the dashboard
# (for previews), as "Build the page" says. Space- or comma-separated.
ROLLOUT_FRAME_ANCESTORS=
# ROLLOUT_DASHBOARD_ORIGIN=https://dashboard.universal.rollout.com
