# Stoop, the demo CRM: the marketplace owner's side of Rollout's Embedded Apps.
# Copy to .env.local for local runs. Never commit real values.

# Where Rollout serves the host library and the Rollout frame.
ROLLOUT_ORIGIN=https://universal.rollout.com

# Rollout dashboard → API page: the client id (your tenant id) and client secret.
# The secret signs the user tokens on the server. Keep it out of the browser and out of git.
ROLLOUT_TENANT_ID=
ROLLOUT_CLIENT_SECRET=

# Rollout dashboard → Marketplace → Settings.
ROLLOUT_MARKETPLACE_ID=
